# ==========================================================
# AI Online Exam & Proctoring System - Environment Configuration Example
# Salin file ini menjadi '.env' di folder utama proyek (Project2/.env)
# ==========================================================

# Database Configuration (Opsional override jika berbeda dengan default config.php)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASS=
# DB_NAME=db_ai_exam

# ==========================================================
# SMTP / EMAIL CONFIGURATION (Contoh Menggunakan Google Mail / Gmail)
# ==========================================================
# CATATAN PENTING GMAIL:
# 1. Aktifkan 'Verifikasi 2 Langkah' (2-Step Verification) di Akun Google Anda.
# 2. Buka menu Keamanan -> Sandi Aplikasi (App Passwords):
#    https://myaccount.google.com/apppasswords
# 3. Buat nama aplikasi 'Exam Online', lalu salin 16 karakter sandi aplikasi.
# 4. JANGAN gunakan password login Gmail biasa! Gunakan App Password.
# 5. JANGAN pernah commit file .env yang berisi password ke git repository!
# ==========================================================

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_google_app_password_here
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="AI Online Exam & Proctoring System"

# Opsional: Google Gemini AI API Key
# GEMINI_API_KEY=your_gemini_api_key_here
